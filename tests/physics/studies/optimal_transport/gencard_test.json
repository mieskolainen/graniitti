// Process steering file
// JSON(5) + single line/multiline comments allowed, trailing comma allowed
//
// The format is strictly upper/lower case sensitive
//
// mikael.mieskolainen@cern.ch, 2026
{

  // ----------------------------------------------------------------------
  // Generic setup

  "GENERIC" : {

    "OUTPUT"     : "test",    // Output filename
    "FORMAT"     : "hepmc3",  // hepmc3, hepmc2, hepevt
    "CORES"      : 0,         // Number of CPU threads (0 for automatic)
    "NEVENTS"    : 100,       // Number of events
    "INTEGRATOR" : "VEGAS",      // "VEGAS" (default), "NEUROJAC", "FLAT" (debug)
    "WEIGHTED"   : false,     // Weighted events (default false)
    "MODELPARAM" : "TUNE0",    // General model tune
    "HIST"       : 2,           // On-the-flight histograms (0 = off,1,2)
    "RNDSEED"    : 12345678     // Random seed (uint32)
  },

  // ----------------------------------------------------------------------
  // Physics process setup

  "SCATTERING" : {


    "BEAM"    : ["p+","p+"],    // Beam PDG-ID / Name
    "ENERGY"  : [6500, 6500],   // Beam energy in the lab (GeV)
    //"PROCESS" : "GP[CON]<F> -> rho(770)0 > {pi+ pi-} rho(770)0 > {pi+ pi-}",
    "PROCESS" : "GP[RES+CON]<F> -> pi+ pi-", // Process mode
    "RES"     : ["f0_500", "rho_770", "f0_980", "f2_1270", "f0_1500", "f2_1525", "f0_1710", "f2_1950"],
    "LOOPSCREEN" : false,          // Initial state event-by-event screening loop
    "NSTARS"  : 0,  // Forward dissociation (0 = elastic, 1 = single, 2 = double)
    "BEAMFRAG": "none",  // Forward dissociation particle production ('none', 'fewbody', 'cylinder', 'diquark')
    "LHAPDF"  : "NNPDF31_lo_as_0118" // LHAPDF parton distribution set
  },
  
  // ----------------------------------------------------------------------
  // Monte Carlo integration setup

  "INTEGRATOR" : {

    // Integration targets after adaptation
    "min_samples" : 1000000,
    "max_samples" : 100000000,
    "precision"   : 0.01,

    // Loop (screening) integrator (see NUMERICS.json for more steering)
    "LOOPSCREEN" : {
      "extra_kt" : 0,   // Extra kT points relative to NUMERICS.json default
      "extra_phi" : 0   // Extra phi points relative to NUMERICS.json default
    },

    // VEGAS integrator
    "VEGAS" : {

      "bins" : 128,      // Maximum number of bins per dimension (NOTE: EVEN NUMBER)
      "alpha" : 1.25,    // Grid adaptation damping exponent
      "rounds" : 8,      // Number of adaptation iterations
      "ncall" : 40000,   // Number of function calls per iteration

      "debug" : -1       // Debug output (default -1)
    },

    // NEUROJAC integrator
    "NEUROJAC" : {},

    // FLAT integrator
    "FLAT" : {},

    // Unweighting max weight
    "max_w_value"  : null  // user can set here (default automatic)
  },
  
  // ----------------------------------------------------------------------
  // Generation cuts

  "GENCUTS" : {

    "<C>" : {
      "M" : [0.2, 6.0],
      "Rap" : [-2.5, 2.5],  // Rapidity boundaries of the final states (<C> class)
      "Xi"  : [0, 0.1],     // Invariant scale M^2/s (forward excitation)
    },
    "<F>" : {
      "Rap" : [-2.5, 2.5],  // Rapidity boundaries of the system (<F> class)
      "M"   : [0.2, 6.0],
      "Xi"  : [0, 0.1],     // Invariant scale M^2/s (forward excitation)
    },
    "<Q>" : {
      "Xi"  : [0, 0.1],     // Invariant scale M^2/s (forward excitation)
    }
  },

  // ----------------------------------------------------------------------
  // [Quasi]-fiducial cuts (AND between all the cuts)

  "FIDCUTS" : {

    "active" : true,

    "CENTRAL" : {

      // "*" for any final state
      // "SYSTEM" for the full central system
      // "[22]" for gammas
      // "[211,-211]" for a pion pair etc

      // [22] : {}
      // [211,-211] : {}

      // Any central system final states
      "*" : {
          
        "Eta"  : [-2.5, 2.5],        // Pseudorapidity
        //"Rap"  : [-10.0, 10.0],    // Rapidity
        "Pt"   : [0.1, 1000.0],      // Transverse momentum
        //"Et"   : [0.0, 100000.0]   // Transverse energy
      },
      
      // Central system
      "SYSTEM" : {
        
        //"M"    : [0.0, 100000.0],  // Mass
        //"Rap"  : [-10.0, 10.0],    // Rapidity
        //"Pt"   : [0.0, 100000.0]   // Transverse momentum
      }
    },

    // Forward system
    "FORWARD" : {
      //"M"    : [0.0, 100000.0],  // Mass
      //"t"    : [0.0, 100000.0],  // Forward protons/N* Mandelstam t (absolute value) (GeV^2)
      //"dPhi" : [0.0, 90.0],      // Absolute azimuthal difference of the two forward final legs (deg)
    },

    // Custom user cuts (default false, otherwise identifier ID)
    "USERCUTS" : false
  },
  
  // ----------------------------------------------------------------------
  // Veto cuts
  // A single particle filling the conditions VETO (reject) the event
  // Particles can originate from any leg of the scattering process

  "VETOCUTS" : {

    "active" : false,

    // Domain 0
    "0" : {
      "Eta" : [-4.9, -3.0],
      "Pt"  : [0.03, 100000.0],
      "sources" : ["forward"],
      "charge" : "charged"
    },
    
    // Domain 1
    "1" : {
      "Eta" : [3.0, 4.9],
      "Pt"  : [0.03, 100000.0],
      "sources" : ["forward"],
      "charge" : "charged"
    },

    // Domain 2 (add arbitrary one more here) ...

  }
}
