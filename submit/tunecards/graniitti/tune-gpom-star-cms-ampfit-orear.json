      "continuum_options": {"FF_offshell": true, "FF_transfer": true, "ff_type": "orear", "tune_couplings": true, "production_mode": "magnitude", "pveto": true, "production_geometry": "projective", "production_active_only": false, "production_m": [0,1,2], "production_relative_range": 0.25},
      "decay": {
        "branching": [{"$ref": "_defaults.json#/icetune/resonance/decay/branching/f0_980"}, {"$ref": "_defaults.json#/icetune/resonance/decay/branching/f0_1710"}, {"$ref": "_defaults.json#/icetune/resonance/decay/branching/f2_1950"}],
        "zeta": {"mode": "phase_raw", "resonances": ["f0_980", "f2_1270", "f0_1500", "f2_1525", "f0_1710", "f2_1950"], "final_states": [[321, -321]]}
