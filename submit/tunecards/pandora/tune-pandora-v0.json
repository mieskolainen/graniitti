    "fiducial": {
      
      // Stable visible truth particles
      "gen": {"gen_status": 1, "final_state_energy_gev": [0.1, null], "final_state_theta_deg": [50.0, 130.0], "excluded_abs_pdgs": [12, 14, 16]},
      
