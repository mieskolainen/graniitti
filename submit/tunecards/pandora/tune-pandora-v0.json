    }
  },
  
  // Particle flow objective
  "param_loss": {
    "epsilon": 1e-12,                         // Numerical floor for logs and denominators

    "energy_bias_target": 0.005,              // Mean energy bias penalty scale
    "energy_bias_tolerance": 0.01,            // Allowed mean energy bias for diagnostics
    "energy_resolution_target": 0.03,         // Target relative event energy resolution
    
    // Particle identification and multiplicity penalties
    "confusion_energy_fraction_target": 0.08, // Scale for misidentified and unmatched energy fractions
    "multiplicity_target": 1.0,               // RMS count error per class and event after fiducial cuts
    "matched_momentum_response_target": 0.16, // Momentum residual scale after event energy rescaling
    
