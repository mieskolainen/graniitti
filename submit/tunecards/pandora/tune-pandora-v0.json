    "matching_max_angle_rad": 0.2,        // Maximum 3D matching angle (rad)
    
    // Simulated samples and parton acceptance
    "generator": {
      
      // Hard parton |cos(theta)| limit
      "max_abs_parton_costheta": 0.4,
      
      // Datasets used in the fit
      "active_datasets": ["zuds_91p2"],

      // File ranges are inclusive, nevents=-1 reads all events
      "datasets": {
          "zuds_91p2": {
          "process": "zuds",
          "sqrts_gev": 91.1876,
          "input_dir": "run/condor_outputs",
          "file_template": "ALLEGRO_ddsim_job_{index:03d}.root",
          "file_ranges": [[0, 19]], "nevents": -1, "weight": 1.0
        }
      }
    },
