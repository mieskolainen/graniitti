{
  "GENERIC": {
    "OUTPUT": "z_merging_0",
    "FORMAT": "lhe",
    "CORES": 0,
    "NEVENTS": 30000,
    "INTEGRATOR": "VEGAS",
    "WEIGHTED": true,
    "MODELPARAM": "TUNE0",
    "HIST": 0,
    "RNDSEED": 12474
  },
  "SCATTERING": {
    "BEAM": ["p+", "p+"],
    "ENERGY": [6500, 6500],
    "PROCESS": "IPp[Z]<F> -> Z > {mu+ mu-}",
    "RES": [],
    "LOOPSCREEN": false,
    "NSTARS": 0,  // Forward dissociation (0 = elastic, 1 = single, 2 = double)
    "BEAMFRAG": "diquark",  // Forward dissociation particle production ('none', 'fewbody', 'cylinder', 'diquark')
    "LHAPDF": "NNPDF31_lo_as_0118"
  },
  "RADIATIVE" : {"ISR_QED" : "none", "FSR_QED" : "none"},

  "INTEGRATOR": {
    "min_samples": 20000,
    "max_samples": 1000000,
    "precision": 0.06,
    "LOOPSCREEN": {
      "extra_kt": 1,
      "extra_phi": 1
    },
    "VEGAS": {
      "bins": 128,
      "alpha": 1.25,
      "rounds": 8,
      "ncall": 10000,
      "debug": -1
    },
    "NEUROJAC": {},
    "FLAT": {},
    "max_w_value": null
  },
  "GENCUTS": {
    "<F>": {
      "Rap": [-10.0,10.0],
      "M": [80,13000.0],
      "Xi": [0, 0.2]
    },
    "<C>": {
      "Rap": [-10.0,10.0],
      "M": [80,13000.0],
      "Xi": [0, 0.2]
    }
  },
  // Final lepton acceptance is applied after Pythia in cuts.py
  "FIDCUTS": {"active": false, "CENTRAL": {}, "FORWARD": {}, "USERCUTS": false},

  "VETOCUTS": {
    "active": false
  }
}
