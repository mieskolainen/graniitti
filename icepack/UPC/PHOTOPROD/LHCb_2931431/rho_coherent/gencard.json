// LHCb neutron-inclusive coherent rho production, acceptance corrected
// [REFERENCE: arXiv:2506.06250v2, Secs. 3 and 5, Eq. (9)]
// The rho-only mass integral ends at 1.510 GeV, no detector pion cuts are reapplied
{
  "GENERIC": {
    "OUTPUT": "LHCb_2931431_rho",
    "FORMAT": "hepmc3",
    "CORES": 0,
    "NEVENTS": 30000,
    "INTEGRATOR": "VEGAS",
    "WEIGHTED": true,
    "MODELPARAM": "TUNE0",
    "HIST": 0,
    "RNDSEED": 2931431
  },
  "SCATTERING": {
    "BEAM": ["Pb208", "Pb208"],
    "ENERGY": [2510, 2510],
    "PROCESS": "GP[RES]<F> -> pi+ pi- @RES{rho_770:1}",
    "RES": [],
    "LOOPSCREEN": true,
    "NSTARS": 0,
    "BEAMFRAG": "none",
    "LHAPDF": "NNPDF31_lo_as_0118"
  },
  "NUCLEAR": {
    "emd": true,
    "fragmentation": "internal",
    "emission": ["coherent", "coherent"],
    // Neutron classes are determined after nuclear breakup and decay, using the emitted neutrons
    // n == 0 = no neutrons, n > 0 = at least one neutron, * = unrestricted
    // Supported comparisons: == (or =), !=, >, >=, <, <= with a nonnegative integer
    // Neutron emission does not determine whether hard production is coherent or incoherent
    "neutron_class": ["*", "*"],
    "screening": "optical",
    "sigma_NN": null,
    "structure": "nucleon",
    "photoproduction": {
      "target": ["coherent", "coherent"],
      "target_model": "glauber"
    }
  },
  "INTEGRATOR": {
    "min_samples": 10000,
    "max_samples": 10000000,
    "precision": 0.05,
    "LOOPSCREEN": {
      "extra_kt": 1,
      "extra_phi": 1
    },
    "VEGAS": {
      "bins": 64,
      "alpha": 1.25,
      "rounds": 8,
      "ncall": 10000,
      "debug": -1
    },
    "NEUROJAC": {},
    "FLAT": {},
    "max_w_value": null
  },
  "GENCUTS": {
    "<C>": {
      "M": [0.2791, 1.51],
      "Rap": [2.05, 4.9]
    },
    "<F>": {
      "M": [0.2791, 1.51],
      "Rap": [2.05, 4.9]
    },
    "<Q>": {
      "Xi": [0.0, 0.01]
    }
  },
  "FIDCUTS": {
    "active": true,
    "CENTRAL": {
      "SYSTEM": {
        "Rap": [2.05, 4.9]
      }
    },
    "FORWARD": {},
    "USERCUTS": false
  },
  "VETOCUTS": {
    "active": false
  }
}
