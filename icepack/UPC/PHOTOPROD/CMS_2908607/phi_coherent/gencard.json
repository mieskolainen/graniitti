// CMS coherent phi generation in PbPb UPCs at sqrt(sNN) = 5.36 TeV
{
  "GENERIC" : {
    "OUTPUT"     : "UPC_CMS_2908607_phi_coherent",
    "FORMAT"     : "hepmc3",
    "CORES"      : 0,
    "NEVENTS"    : 30000,
    "INTEGRATOR" : "VEGAS",
    "WEIGHTED"   : true,
    "MODELPARAM" : "TUNE0",
    "HIST"       : 0,
    "RNDSEED"    : 2908607
  },

  "SCATTERING" : {

    "BEAM"    : ["Pb208","Pb208"],
    "ENERGY"  : [2680,2680],  // Energy per nucleon [GeV]
    "PROCESS" : "GP[RES]<F> -> K+ K- @RES{phi_1020:1}",
    "RES"     : [],
    "LOOPSCREEN" : true,
    "NSTARS"  : 0,  // Forward dissociation (0 = elastic, 1 = single, 2 = double)
    "BEAMFRAG": "none",  // Forward dissociation particle production ('none', 'fewbody', 'cylinder', 'diquark')
    "LHAPDF"  : "NNPDF31_lo_as_0118"
  },

  "NUCLEAR" : {
    "emd": true,
    "fragmentation": "internal",
    "emission"     : ["coherent","coherent"],
    // Neutron classes are determined after nuclear breakup and decay, using the emitted neutrons
    // n == 0 = no neutrons, n > 0 = at least one neutron, * = unrestricted
    // Supported comparisons: == (or =), !=, >, >=, <, <= with a nonnegative integer
    // Neutron emission does not determine whether hard production is coherent or incoherent
    "neutron_class": ["*","*"],
    "screening"     : "optical",
    "sigma_NN"     : null,
    
    "structure"    : "nucleon",
    "photoproduction": {
      "target": ["coherent","coherent"],
      "target_model" : "glauber"
    }
  },

  "INTEGRATOR" : {
    "min_samples" : 10000,
    "max_samples" : 10000000,
    "precision"   : 0.05,
    "LOOPSCREEN"     : {"extra_kt" : 1, "extra_phi" : 1},
    "VEGAS" : {
      "bins"  : 64,
      "alpha" : 1.25,
      "rounds": 8,
      "ncall" : 10000,
      "debug" : -1
    },
    "NEUROJAC" : {},
    "FLAT"     : {},
    "max_w_value" : null
  },
  
  // Sample one rapidity side of symmetric PbPb production
  "GENCUTS" : {
    // Cover the full signal extraction mass interval [REFERENCE: arXiv:2504.05193, signal extraction]
    "<C>" : {"M": [0.98,1.15], "Rap": [0.3,1.0]},
    "<F>" : {"M": [0.98,1.15], "Rap": [0.3,1.0]},
    "<Q>" : {"Xi" : [0.0,0.01]}
  },

  "FIDCUTS" : {
    "active"   : true,
    "CENTRAL"  : {
      "SYSTEM" : {"M" : [0.98,1.15], "Rap" : [0.3,1.0]}
    },
    "FORWARD"  : {},
    "USERCUTS" : false
  },

  "VETOCUTS" : {"active" : false}
}
