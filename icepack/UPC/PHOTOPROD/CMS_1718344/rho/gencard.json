// CMS lab rapidity, Pb along +z and proton along -z after combining beam periods
// [REFERENCE: arXiv:1902.01339v3, Secs. 3, 5 and 8]
// The measured |t| is dipion pT^2, the cut removes the coherent gamma-Pb peak
// Rho-only mass integral 0.28 to 1.50 GeV, acceptance corrected pion decay
{
  "GENERIC": {
    "OUTPUT": "CMS_1718344_rho",
    "FORMAT": "hepmc3",
    "CORES": 0,
    "NEVENTS": 30000,
    "INTEGRATOR": "VEGAS",
    "WEIGHTED": true,
    "MODELPARAM": "TUNE0",
    "HIST": 0,
    "RNDSEED": 1718344
  },
  "SCATTERING": {
    "BEAM": ["Pb208", "p+"],
    "ENERGY": [1580, 4000],
    "PROCESS": "GP[RES]<F> -> pi+ pi- @RES{rho_770:1}",
    "RES": [],
    "LOOPSCREEN": true,
    "NSTARS": 0,
    "BEAMFRAG": "none",
    "LHAPDF": "NNPDF31_lo_as_0118"
  },
  "NUCLEAR": {
    "emd": true,
    "fragmentation": "internal",
    "emission": ["coherent", "coherent"],
    // Neutron classes are determined after nuclear breakup and decay, using the emitted neutrons
    // n == 0 = no neutrons, n > 0 = at least one neutron, * = unrestricted
    // Supported comparisons: == (or =), !=, >, >=, <, <= with a nonnegative integer
    // Neutron emission does not determine whether hard production is coherent or incoherent
    "neutron_class": ["*", "*"],
    "screening": "optical",
    "sigma_NN": null,
    "structure": "nucleon",
    "photoproduction": {
      "target": ["coherent", "coherent"],
      "target_model": "glauber"
    }
  },
  "INTEGRATOR": {
    "min_samples": 10000,
    "max_samples": 10000000,
    "precision": 0.05,
    "LOOPSCREEN": {
      "extra_kt": 1,
      "extra_phi": 1
    },
    "VEGAS": {
      "bins": 64,
      "alpha": 1.25,
      "rounds": 8,
      "ncall": 10000,
      "debug": -1
    },
    "NEUROJAC": {},
    "FLAT": {},
    "max_w_value": null
  },
  "GENCUTS": {
    "<C>": {
      "M": [0.28, 1.5],
      "Rap": [-2, 2]
    },
    "<F>": {
      "M": [0.28, 1.5],
      "Rap": [-2, 2]
    },
    "<Q>": {
      "Xi": [0.0, 0.01]
    }
  },
  "FIDCUTS": {
    "active": true,
    "CENTRAL": {
      "SYSTEM": {
        "Rap": [-2, 2],
        "Pt": [0.15811388300841897, 1.0]
      }
    },
    "FORWARD": {},
    "USERCUTS": false
  },
  "VETOCUTS": {
    "active": false
  }
}
