// Physical Au197 beams with spin-averaged coherent charge and matter currents
// Measured Au GDR, mass-scaled Pb high-energy absorption, shared thermalization model
// [REFERENCE: arXiv:1702.07705v1, Secs. 3 and 4, Tables 2 and 7]
// Published rho-only integral from 2 m_pi to fitted m_rho + 5 Gamma_rho
{
  "GENERIC": {
    "OUTPUT": "STAR_1515028_rho",
    "FORMAT": "hepmc3",
    "CORES": 0,
    "NEVENTS": 30000,
    "INTEGRATOR": "VEGAS",
    "WEIGHTED": true,
    "MODELPARAM": "TUNE0",
    "HIST": 0,
    "RNDSEED": 1515028
  },
  "SCATTERING": {
    "BEAM": ["Au197", "Au197"],
    "ENERGY": [100, 100],
    "PROCESS": "GP[RES]<F> -> pi+ pi- @RES{rho_770:1}",
    "RES": [],
    "LOOPSCREEN": true,
    "NSTARS": 0,
    "BEAMFRAG": "none",
    "LHAPDF": "NNPDF31_lo_as_0118"
  },
  "NUCLEAR": {
    "emd": true,
    "fragmentation": "internal",
    "emission": ["coherent", "coherent"],
    // Neutron classes are determined after nuclear breakup and decay, using the emitted neutrons
    // n == 0 = no neutrons, n > 0 = at least one neutron, * = unrestricted
    // Supported comparisons: == (or =), !=, >, >=, <, <= with a nonnegative integer
    // Neutron emission does not determine whether hard production is coherent or incoherent
    "neutron_class": ["n > 0", "n > 0"],
    "screening": "optical",
    "sigma_NN": null,
    "structure": "nucleon",
    "photoproduction": {
      "target": ["coherent", "coherent"],
      "target_model": "glauber"
    }
  },
  "INTEGRATOR": {
    "min_samples": 10000,
    "max_samples": 10000000,
    "precision": 0.05,
    "LOOPSCREEN": {
      "extra_kt": 1,
      "extra_phi": 1
    },
    "VEGAS": {
      "bins": 64,
      "alpha": 1.25,
      "rounds": 8,
      "ncall": 10000,
      "debug": -1
    },
    "NEUROJAC": {},
    "FLAT": {},
    "max_w_value": null
  },
  "GENCUTS": {
    "<C>": {
      "M": [0.2791, 1.5562],
      "Rap": [-1, 1]
    },
    "<F>": {
      "M": [0.2791, 1.5562],
      "Rap": [-1, 1]
    },
    "<Q>": {
      "Xi": [0.0, 0.01]
    }
  },
  "FIDCUTS": {
    "active": true,
    "CENTRAL": {
      "SYSTEM": {
        "Rap": [-1, 1]
      }
    },
    "FORWARD": {},
    "USERCUTS": false
  },
  "VETOCUTS": {
    "active": false
  }
}
