{
  "GENERIC" : {
    "OUTPUT"     : "diffz_yy_mumu",
    "FORMAT"     : "hepmc3",
    "CORES"      : 0,
    "NEVENTS"    : 30000,
    "INTEGRATOR" : "VEGAS",        // "VEGAS" (default), "NEUROJAC", "FLAT" (for debug)
    "WEIGHTED"   : true,
    "MODELPARAM" : "TUNE0",
    "HIST"       : 0,
    "RNDSEED"    : 12476
  },
  
  "SCATTERING" : {

    "BEAM"    : ["p+","p+"],
    "ENERGY"  : [6500, 6500],
    "PROCESS" : "yy[EPA]<F> -> mu+ mu-",
    "RES"     : [],
    "LOOPSCREEN" : false,
    "NSTARS"  : 0,  // Forward dissociation (0 = elastic, 1 = single, 2 = double)
    "BEAMFRAG": "diquark",  // Forward dissociation particle production ('none', 'fewbody', 'cylinder', 'diquark')
    "LHAPDF"  : "NNPDF31_lo_as_0118"
  },

  "RADIATIVE" : {"ISR_QED" : "none", "FSR_QED" : "none"},

  "INTEGRATOR" : {

    // Integration targets after adaptation
    "min_samples" : 100000,
    "max_samples" : 100000000,
    "precision"   : 0.01,

    "LOOPSCREEN" : {"extra_kt" : 1, "extra_phi" : 1},
    // VEGAS integrator
    "VEGAS" : {

      "bins" : 128,      // Maximum number of bins per dimension (NOTE: EVEN NUMBER)
      "alpha" : 1.25,    // Grid adaptation damping exponent
      "rounds" : 8,      // Number of adaptation iterations
      "ncall" : 40000,   // Number of function calls per iteration

      "debug" : -1       // Debug output (default -1)
    },

    "NEUROJAC" : {},

    "FLAT" : {},

    // Unweighting max weight
    "max_w_value"  : null  // user can set here (default automatic)
  },

  "GENCUTS" : {
    "<C>" : {"M" : [15,13000.0], "Rap" : [-10.0,10.0]},
    "<F>" : {"M" : [15,13000.0], "Rap" : [-10.0,10.0]},
    "<Q>" : {"Xi" : [0, 0.05]}
  },

  // Final lepton acceptance is applied after Pythia in cuts.py
  "FIDCUTS": {"active": false, "CENTRAL": {}, "FORWARD": {}, "USERCUTS": false},

  "VETOCUTS" : {"active" : false}
}
