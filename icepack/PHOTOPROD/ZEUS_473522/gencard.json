// HERA vector meson photoproduction with exact ep cuts in each icepack
{
  "GENERIC": {
    "OUTPUT": "hera_vector", "FORMAT": "hepmc3", "CORES": 0,
    "NEVENTS": 30000, "INTEGRATOR": "VEGAS", "WEIGHTED": true,
    "MODELPARAM": "TUNE0", "HIST": 0, "RNDSEED": 451266
  },
  "SCATTERING": {
    "BEAM": ["e+","p+"], "ENERGY": [27.5,820.0],
    "PROCESS": "GP[RES]<F> -> mu+ mu- @RES{psi2S:1}",
    "RES": [], "LOOPSCREEN": false,
    "NSTARS": 0,  // Forward dissociation (0 = elastic, 1 = single, 2 = double)
    "BEAMFRAG": "none",  // Forward dissociation particle production ('none', 'fewbody', 'cylinder', 'diquark')
    "LHAPDF": "NNPDF31_lo_as_0118"
  },
  "INTEGRATOR": {
    "min_samples": 100000, "max_samples": 100000000, "precision": 0.02,
    "LOOPSCREEN": {"extra_kt": 0, "extra_phi": 0},
    "VEGAS": {"bins": 128, "alpha": 1.25, "rounds": 8, "ncall": 40000, "debug": -1},
    "NEUROJAC": {}, "FLAT": {}, "max_w_value": null
  },
  // Full physical rapidity and forward transverse momentum support at HERA
  "GENCUTS": {
    "<C>": {"M": [3.6,3.8], "Rap": [-10.0,10.0]},
    "<F>": {"M": [3.6,3.8], "Rap": [-10.0,10.0], "Pt": [0.0,160.0]}
  },
  // t1 = (p_e - p_e')^2 = -Q2, so |t1| = Q2 for electron beam 1 (GeV^2)
  "FIDCUTS": {"active": true, "CENTRAL": {}, "FORWARD": {"t1": [0.0,4.0]}, "USERCUTS": false},
  "VETOCUTS": {"active": false}
}
