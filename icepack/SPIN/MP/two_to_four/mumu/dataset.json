        "chi_c1.json:PARAM_RES.MODELS.MP[\"[995,995]\"].g": [1.0, 0.0],
        "DECAYS.json:[\"20443\"][\"[333,333]\"].BR": 0.01,
        "DECAYS.json:[\"20443\"][\"[333,333]\"].alpha_ls": [[2, 2, 1.0, 0.0]]
