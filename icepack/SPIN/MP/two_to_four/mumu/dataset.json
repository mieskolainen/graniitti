        "chi_c2.json:PARAM_RES.MODELS.MP[\"[995,995]\"].basis": "auto_min_L",
        "chi_c2.json:PARAM_RES.MODELS.MP[\"[995,995]\"].polarization.mode": "none",
        "chi_c2.json:PARAM_RES.MODELS.MP[\"[995,995]\"].g": [1.0, 0.0],
        "DECAYS.json:[\"445\"][\"[333,333]\"].BR": 0.01,
        "DECAYS.json:[\"445\"][\"[333,333]\"].alpha_ls": [[0, 2, 1.0, 0.0]]
      }
    }
  ],
  "plot": {
    "normalization": "unit_density",
    "density_uncertainty": "shape",
    "ratio_uncertainty": "combined",
    "stack": false,
    "data_style": "hist"
  },
  "fit": {"normalization": "unit_density"},
  "sets": [
    {
      "name": "Two to four body dimuon spin",
      "title": "MP spin comparison, common $M=2.7$ GeV, $\\Gamma=0.15$ GeV",
      "data": false,
      "pid": [13, -13, 13, -13],
      "cuts": "icepack/_common/cuts_inclusive.py",
      "obs": "core.analysis.observables.four_body",
      "hist": [
        {
          "obs": "4body_cos1",
          "args": {"target_m": 1.01946}
        },
        {
          "obs": "4body_cos2",
          "args": {"target_m": 1.01946}
        },
        {
