// Controlled synthetic JPC comparison with common parent mass, width, production form factors and vector daughters
// The resonance card names supply spin and parity only, these are not physical chi_c pole predictions
// Pure allowed decay LS waves: 0++ (0,0), 0-+ (1,1), 1++ (2,2), 2++ (0,2)
// Unit-density shapes use a common illustrative VV branching fraction and full decay acceptance
{
  "active": true,
  "type": "MC_ONLY",
  "samples": [
    {
      "name": "flat",
      "label": "MP synthetic pole, spin decay off",
      "gencard": "icepack/SPIN/_common/gencard_4body.json",
      "parameters": {
        "SCATTERING.PROCESS": "MP[RES]<F> -> phi(1020)0 > {mu+ mu-} phi(1020)0 > {mu+ mu-} @R[f0_1710]{M:2.7,W:0.15} @RES{f0_1710:1} @SPINDEC:false",
        "GENCUTS.<F>.M": [2.25, 3.15],
        "FIDCUTS.active": false,
        "GENERAL.json:PARAM_SPIN.DECAY_SYM": true,
        "f0_1710.json:PARAM_RES.MODELS.MP.BW": "fixed-width",
        "f0_1710.json:PARAM_RES.MODELS.MP.FF_transfer": {
          "type": "power",
          "norm": "zero",
          "Lambda2": 0.5,
          "n": 1.0
        },
        "f0_1710.json:PARAM_RES.MODELS.MP.FF_prod": {
          "type": "gaussian",
          "norm": "pole",
          "Lambda2": 2.0
        },
        "f0_1710.json:PARAM_RES.MODELS.MP[\"[995,995]\"].basis": "auto_min_L",
        "f0_1710.json:PARAM_RES.MODELS.MP[\"[995,995]\"].polarization.mode": "none",
        "f0_1710.json:PARAM_RES.MODELS.MP[\"[995,995]\"].g": [1.0, 0.0],
        "DECAYS.json:[\"10331\"][\"[113,113]\"].BR": 0.01,
        "DECAYS.json:[\"10331\"][\"[113,113]\"].alpha_ls": [[0, 0, 1.0, 0.0]],
        "DECAYS.json:[\"10331\"][\"[113,113]\"].@key": "[333,333]"
      }
    },
    {
      "name": "jp0p",
      "label": "MP synthetic pole, $0^{++}$",
