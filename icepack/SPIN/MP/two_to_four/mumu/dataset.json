        "GENCUTS.<F>.M": [2.25, 3.15],
        "FIDCUTS.active": false,
        "GENERAL.json:PARAM_SPIN.DECAY_SYM": true,
        "chi_c2.json:PARAM_RES.MODELS.MP.BW": "fixed-width",
        "chi_c2.json:PARAM_RES.MODELS.MP.FF_transfer": {
