        "chi_c1.json:PARAM_RES.MODELS.MP.FF_transfer": {
          "type": "power",
          "norm": "zero",
          "Lambda2": 0.5,
          "n": 1.0
        },
        "chi_c1.json:PARAM_RES.MODELS.MP.FF_prod": {
          "type": "gaussian",
