      "SYSTEM": {"M": [0.0,100000.0], "Rap": [-10.0,10.0], "Pt": [0.0,100000.0]}
    },
    "FORWARD": {"t": [0.0,100000.0]},
    "USERCUTS": false
  },
  "VETOCUTS": {
    "active": false,
    "0": {"Eta": [-7.0,-2.5], "Pt": [0.05,100000.0]},
    "1": {"Eta": [2.5,7.0], "Pt": [0.05,100000.0]}
  }
