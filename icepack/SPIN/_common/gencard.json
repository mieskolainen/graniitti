// Jacob-Wick polarization steering for central resonances

{
  "GENERIC": {
    "OUTPUT": "jw_polarization",
    "FORMAT": "hepmc3",
    "CORES": 0,
    "NEVENTS": 30000,
    "INTEGRATOR": "VEGAS",
