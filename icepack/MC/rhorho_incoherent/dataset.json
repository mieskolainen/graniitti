// Compare coherent and incoherent identical-pion decay assignments at fixed production steering
// Physical interference may change both rates and shapes, no equality requirement is imposed
// Sampler agreement for DECAY_SYM=false is checked in closure/dataset.json
{
  "active": true,
  "type": "MC_ONLY",
  "samples": [
    {
      "name": "sym_off",
      "label": "GP continuum, DECAY_SYM=false",
      "gencard": "icepack/SPIN/_common/gencard_4body.json",
      "parameters": {
        "GENERIC.INTEGRATOR": "VEGAS",
        "GENERIC.RNDSEED": 32600,
        "SCATTERING.PROCESS": "GP[CON]<F> -> rho(770)0 > {pi+ pi-} rho(770)0 > {pi+ pi-} @OFFSHELL:3 @FLATMASS2:false",
        "GENCUTS.<F>.M": [0.0, 4.0],
        "GENCUTS.<F>.Rap": [-0.9, 0.9],
        "FIDCUTS.active": true,
        "FIDCUTS.CENTRAL[\"*\"].Eta": [-0.9, 0.9],
        "FIDCUTS.CENTRAL[\"*\"].Rap": [-0.9, 0.9],
        "FIDCUTS.CENTRAL[\"*\"].Pt": [0.15, 100000.0],
        "FIDCUTS.CENTRAL[\"SYSTEM\"].M": [0.0, 4.0],
        "FIDCUTS.CENTRAL[\"SYSTEM\"].Rap": [-0.9, 0.9],
        "GENERAL.json:PARAM_SPIN.DECAY_SYM": false
      }
    },
    {
      "name": "sym_on",
      "label": "GP continuum, DECAY_SYM=true",
      "gencard": "icepack/SPIN/_common/gencard_4body.json",
      "parameters": {
        "GENERIC.INTEGRATOR": "VEGAS",
        "GENERIC.RNDSEED": 24681,
        "SCATTERING.PROCESS": "GP[CON]<F> -> rho(770)0 > {pi+ pi-} rho(770)0 > {pi+ pi-} @OFFSHELL:3 @FLATMASS2:false",
        "GENCUTS.<F>.M": [0.0, 4.0],
        "GENCUTS.<F>.Rap": [-0.9, 0.9],
        "FIDCUTS.active": true,
        "FIDCUTS.CENTRAL[\"*\"].Eta": [-0.9, 0.9],
        "FIDCUTS.CENTRAL[\"*\"].Rap": [-0.9, 0.9],
        "FIDCUTS.CENTRAL[\"*\"].Pt": [0.15, 100000.0],
        "FIDCUTS.CENTRAL[\"SYSTEM\"].M": [0.0, 4.0],
        "FIDCUTS.CENTRAL[\"SYSTEM\"].Rap": [-0.9, 0.9],
        "GENERAL.json:PARAM_SPIN.DECAY_SYM": true
      }
    }
  ],
  "plot": {
    "normalization": "cross_section",
    "ratio_uncertainty": "combined",
    "stack": false,
    "data_style": "hist"
  },
  "fit": {"normalization": "cross_section"},
  "validation": {
    "nevents": 50000,
    "mc_reference": "sym_off",
    "require_comparison": true,
    "require_differential_comparison": true,
    "require_fiducial_integral_comparison": true,
    "min_mc_effective_events": 3000
  },
  "sets": [
    {
      "name": "rhorho coherent and incoherent decay trees",
      "title": "$|\\eta_{\\pi}|<0.9$, $|y_{\\pi}|<0.9$, $p_{T,\\pi}>0.15$ GeV, $M_X<4$ GeV, $|y_X|<0.9$",
      "data": false,
      "pid": [211, -211, 211, -211],
      "cuts": "icepack/_common/cuts_inclusive.py",
      "obs": "../_common/obs_four_body.py",
      "hist": [
        {"obs": "cross_section"},
        {"obs": "M"},
        {"obs": "Rap"},
        {"obs": "dPhi_pp"},
        {"obs": "4body_M_A"},
        {"obs": "4body_M_B"},
        {"obs": "4body_cos1"},
        {"obs": "4body_cos2"},
        {"obs": "4body_phi12"}
      ]
    }
  ]
}
