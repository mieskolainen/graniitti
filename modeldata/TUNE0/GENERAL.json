{

// Parameters used by yy->yy and gg->yy loop amplitudes
// Light quarks use MSbar masses at 2 GeV,
// charm and bottom at their own mass, top uses the pole mass
"PARAM_SM": {
  "alpha_em_inv": 127.9,
  "mass": {
    "e":   0.00051099895000,
    "mu":  0.1056583755,
    "tau": 1.77693,
    "u":   0.00216,
    "d":   0.00470,
    "s":   0.0935,
    "c":   1.2730,
    "b":   4.183,
    "t":   172.4,
    "w":   80.3692
  }
},

// Exponential slope convention:
// Capital B in steering field names denotes a cross-section slope [GeV^-2]
// An amplitude factor uses exp(B*t/2), while a squared weight or flux uses exp(B*t)
// Lowercase form-factor parameters such as b and Regge trajectory slopes
// follow the definitions of their respective models

// ---------------------------------------------------------------------
// [Global soft model parameters]

// [IMPACT: eikonal screening, elastic, SD, DD, all soft processes proton vertices]

"PARAM_SOFT": {

  // =====================================================
  // Regenerate derived couplings after changing active_model:
  //   python develop/tools/DL_couplings.py   --push
  //   python develop/tools/HERA_couplings.py --push

  "active_model": "single", // 'single', 'double', ...
  // =====================================================

  // Phenomenological proton-dissociation form factor
  // [IMPACT: SD/DD dissociative CEP]
  "FORWARD_EXCITATION": {
    "s0": 1.0,    // GeV^2
    "a":  0.5616  // GeV^2
  },
  
  "EXCHANGE_DEF": {
    "P":     {"role": "pomeron", "trajectory_mode": "pion_loop", "tau":  1, "crossing":  1},
    "O":     {"role": "odderon", "trajectory_mode": "linear",    "tau": -1, "crossing": -1},
    "R_f2":  {"role": "reggeon", "trajectory_mode": "linear",    "tau":  1, "crossing":  1},
    "R_rho": {"role": "reggeon", "trajectory_mode": "linear",    "tau": -1, "crossing": -1},
    "O3g":   {"role": "odderon", "trajectory_mode": "linear",    "tau": -1, "crossing": -1}
  },

  // GW.a_c defines only a resolved direction and is normalized after parsing
  // It selects one coherent low mass Good Walker direction and the resolved 3P projector
  // It supplies no coupling, normalization or forward mass dependence

  // Real symmetric exchange matrices share an eigenbasis exactly when they commute

  "MODEL": {

    // N=1 channel (icetune done with elastic pp & ppbar)
    "single": {
      "GW": {"theta": [], "a_c": []},
      "EIKONAL":  {"unitarization": "q_exp", "q": 0.41987956483588146, "screening_exchanges": ["P"], "excitation_exchanges": ["P"], "helicity": false},
      "pion_loop_scale2": 6.331252661415344,

      "EXCHANGE": {
        "P":     {"on": true, "alpha": [1.090019284214603, 0.19022451576817273], "g": [[7.772096730400218]],  "sign": 1,  "eta_mode": "rotating", "ff": "P", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "O":     {"on": true, "alpha": [1.0483688003133602, 0.06733770646227784], "g": [[0.7715114960370147]],  "sign": -1, "eta_mode": "rotating", "ff": "O", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "R_f2":  {"on": true, "alpha": [0.4814415721662879, 0.9477136811222054], "g": [[14.49123873996377]], "sign": 1,  "eta_mode": "rotating", "ff": "R", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "R_rho": {"on": true, "alpha": [0.5679995317172248, 0.934196413228639], "g": [[8.956886580922133]],  "sign": 1,  "eta_mode": "rotating", "ff": "R", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "O3g":   {"on": true, "alpha": [1.0081182278990208, 0.043626011533083146], "g": [[0.2629194936235883]],  "sign": -1, "eta_mode": "rotating", "ff": "O3g", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
      },

      "FF": {
        "P":   {"type": "DPOW", "param": [[0.8714829200348211, 0.911398050071061, 1.069096326828003]]},
        "O":   {"type": "DPOW", "param": [[1.178621647255004, 1.9509638842374912, 0.9984206313310175]]},
        "R":   {"type": "EXP",  "param": [[4.1301685501095555]]},
        "O3g": {"type": "3G",   "param": [[0.3805690655162575]]}
      },

      // Use the rotating phase without unphysical spacelike signature poles
      "3P": {"g": 0.20, "eta_mode": "rotating"} // Triple pomeron (SD,DD..)
    },
    
    // N=2 channel (icetune done with elastic pp & ppbar, should include also low-mass dissociation)
    "double": {
      "GW":       {"theta": [0.4219083284081683], "a_c": [1.0]},
      "EIKONAL":  {"unitarization": "q_exp", "q": 0.5147206127565073, "screening_exchanges": ["P"], "excitation_exchanges": ["P"], "helicity": false},
      "pion_loop_scale2": 3.0017306056076594,

      // Exchange trajectories and eigenstate couplings, with a diagonal Pomeron in the Good Walker basis
      "EXCHANGE": {
        "P":     {"on": true, "alpha": [1.0895149718571535, 0.1445356438892305], "g": [[8.115524648990098, 0.0000],  [0.0000, 7.25094794537803]],  "sign": 1,  "eta_mode": "rotating", "ff": "P", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "O":     {"on": true, "alpha": [0.9971735248446801, 0.06924095138976091], "g": [[4.409946407567515, 0.30149226006687224], [0.30149226006687224, 1.1713566303589482]], "sign": -1, "eta_mode": "rotating", "ff": "O", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "R_f2":  {"on": true, "alpha": [0.5188977883184492, 0.9033758667693106], "g": [[16.493714193624598, -0.08557383323382635], [-0.08557383323382635, 9.736970494513715]],  "sign": 1,  "eta_mode": "rotating", "ff": "R", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "R_rho": {"on": true, "alpha": [0.5285548889768386, 0.9135624467193795], "g": [[9.64935254905644, 0.1832722824693173],  [0.1832722824693173, 4.994471640063182]],  "sign": 1,  "eta_mode": "rotating", "ff": "R", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "O3g":   {"on": true, "alpha": [1.0318967293527634, 0.0710617952261157], "g": [[0.8005947720005694, 0.4222748234757083],  [0.4222748234757083, 1.3217644726312507]],  "sign": -1, "eta_mode": "rotating", "ff": "O3g", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
      },

      // Form factors for each exchange per eigenstate
      "FF": {
        "P":   {"type": "DPOW", "param": [[0.41727864729800096, 1.8258835744801944, 1.1239280326904109], [2.4083741199107322, 3.39970194158101, 2.0114116977343532]]},
        "O":   {"type": "DPOW", "param": [[1.1003618547947185, 3.600165040598462, 1.3796210801170379], [1.3628058059633628, 4.111096310144165, 1.0501511318613064]]},
        "R":   {"type": "EXP",  "param": [[3.6972917297942827], [4.019369549782414]]},
        "O3g": {"type": "3G",   "param": [[0.6278252867844213], [0.09040490338116441]]}
      },

      "3P": {"g": 0.20, "eta_mode": "rotating"}
    },

    // N=3 channel (no tuning done)
    "triple": {
      "GW":       {"theta": [0.3200, 0.1200, 0.0800], "a_c": [0.8000, 0.6000]},
      "EIKONAL":  {"unitarization": "q_exp", "q": 0.46, "screening_exchanges": ["P"], "excitation_exchanges": ["P"], "helicity": false},
      "pion_loop_scale2": 6.0,

      "EXCHANGE": {
        "P":     {"on": true, "alpha": [1.0900, 0.1800], "g": [[8.4000, 0.0000, 0.0000],  [0.0000, 6.2000, 0.0000],  [0.0000, 0.0000, 4.5000]], "sign": 1,  "eta_mode": "rotating", "ff": "P", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "O":     {"on": true, "alpha": [1.0300, 0.0800], "g": [[5.0000, -0.4000, 0.0000], [-0.4000, 0.3500, 0.0000], [0.0000, 0.0000, 0.2000]], "sign": -1, "eta_mode": "rotating", "ff": "O", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "R_f2":  {"on": true, "alpha": [0.5475, 0.9000], "g": [[17.0000, 0.0000, 0.0000], [0.0000, 9.0000, 0.0000],  [0.0000, 0.0000, 5.0000]], "sign": 1,  "eta_mode": "rotating", "ff": "R", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "R_rho": {"on": true, "alpha": [0.5475, 0.9000], "g": [[9.6000, 0.0000, 0.0000],  [0.0000, 5.0000, 0.0000],  [0.0000, 0.0000, 3.0000]], "sign": 1,  "eta_mode": "rotating", "ff": "R", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
        "O3g":   {"on": true, "alpha": [1.0100, 0.0000], "g": [[0.3000, -0.1500, 0.0000], [-0.1500, 0.1200, 0.0000], [0.0000, 0.0000, 0.0800]], "sign": -1, "eta_mode": "rotating", "ff": "O3g", "transition_ff": "geometric", "helicity": {"kappa": 0.0, "B_kappa": 0.0}},
      },

      "FF": {
        "P":   {"type": "DPOW", "param": [[0.4670, 1.9090, 1.1410], [1.6570, 1.7840, 1.4650], [2.0000, 1.7000, 1.3000]]},
        "O":   {"type": "DPOW", "param": [[0.9000, 1.8000, 1.2000], [1.2000, 2.4000, 1.1000], [1.5000, 2.2000, 1.1000]]},
        "R":   {"type": "EXP",   "param": [[4.0000], [4.0000], [4.0000]]},
        "O3g": {"type": "3G",   "param": [[1.0000], [1.0000], [1.0000]]}
      },

      "3P": {"g": 0.20, "eta_mode": "rotating"}
    }
  }
},

// ---------------------------------------------------------------------
// [Shared helicity and Jacob-Wick spin treatments]
//

"PARAM_SPIN" : {

  "SPINGEN": true,  // Initial state spin correlations
  "SPINDEC": true,  // Resonance decay spin correlations
  "QMETRICS": false,  // Initialization references and integrated quantum metrics

  // [MP/XP/GP and elastic QED sources] Forward proton spin treatment
  // When true, drops forward proton helicity flip (+ > - and - > +) amplitudes
  "FORWARD_NOFLIP": true,

  // [All amplitudes using JW-decays] Decay tree coherent Boson/Fermion permutation sums
  "DECAY_SYM": true
},

// ---------------------------------------------------------------------
// [MP/XP/GP model processes]
//
// J^PC and PDG ids for different pomerons/odderons/reggeons are
// defined in PDG_EXTRA.json

"PARAM_REGGE" : {

  // [MP] Central polarization frame for production and Jacob-Wick decay
  // "CS" is Collins-Soper, "HX" is helicity, "CM" is the unrotated rest frame
  "MP_FRAME": "CS",

  // Resonance production LS (q/Lambda)^L factors
  "DERIVATIVE_FACTOR": {"GP": false, "MP": false, "XP": false},

  // Decay LS threshold q^L factors
  "DECAY_BARRIERS":{"GP": false, "MP": false, "XP": false},

  // Decay phase in resonance decays (set under DECAYS.json)
  "use_zeta": {"GP": true, "MP": true, "XP": true},

  // Elastic proton vertex
  // 'helicity_residue' ~ Regge exchange helicity with qT^|m| barrier
  // 'unit_residue'     ~ Regge exchange helicity without qT^|m| weights
  "FORWARD_VERTEX": {"GP": "helicity_residue", "MP": "helicity_residue", "XP": "helicity_residue"},

  // Photon source vertex treatment, "EPA" or "QED"
  "PHOTON_VERTEX": {"GP": "EPA", "MP": "EPA", "XP": "EPA"},

  // Continuum A_t + sign*A_u: "auto" uses Bose/Fermi statistics
  // "positive" / "negative" force +/- for interference studies (debug option)
  "TU_SIGN": {"GP": "auto", "MP": "auto", "XP": "auto"},
  
  // Pomeron-Pomeron-Resonance vertex energy dependence [s0/shat]^{omega} parameter
  // Not applied when photon is involved in the process, like photoproduction
  "omega": {"GP": 0.6349881157252373, "MP": 0.5, "XP": 0.5},
  
  // Each row maps one central PDG alias family to a complete PARAM_SOFT exchange
  // pole_spin defines normalization reference point
  "EXCHANGES": [
    {"role": "pomeron", "pdg": [990,   991,  993,  995], "pole_spin": 2, "soft_exchange": "P"},
    {"role": "reggeon", "pdg": [9910, 9915, 9920, 9925], "pole_spin": 2, "soft_exchange": "R_f2"},
    {"role": "reggeon", "pdg": [9930, 9933, 9940, 9943], "pole_spin": 1, "soft_exchange": "R_rho"},
    {"role": "odderon", "pdg": [9990, 9991, 9993, 9997], "pole_spin": 1, "soft_exchange": "O"}
  ],

  // Normalization scale (GeV^2)
  "s0": 1.0,

  // Continuum process parameters
  "PARAM_CON": {

    // Analytic Regge-helicity model exchange pairs
    "GP": {
      "[211,-211]":   [[990,990], [990,9910], [9910,9910]], //, [990,9930], // pi+,pi-
      "[321,-321]":   [[990,990], [990,9910], [9910,9910]], //, [990,9930]], // K+,K-
      "[2212,-2212]": [[990,990], [990,9910], [9910,9910]], //, [990,9910]], //[990,9930]], // p,pbar
      "[2112,-2112]": [[990,990]], //, n,nbar
      "[111,111]":    [[990,990]], //, [990,9910]], // pi0,pi0
      "[311,-311]":   [[990,990]], //, [990,9910]], // K0,K0bar
      "[113,113]":    [[990,990]], //, [990,9910]], // rho0,rho0
      "[333,333]":    [[990,990]]                   // phi,phi
    },

    // Fixed-spin Jacob-Wick model exchange pairs
    "MP": {
      "[211,-211]":   [[995,995], [995,9915], [9915,9915]], // [995,9933], // pi+,pi-
      "[321,-321]":   [[995,995], [995,9915], [9915,9915]], //[995,9933]], // K+,K-
      "[2212,-2212]": [[995,995], [995,9915], [9915,9915]], // [995,9915]], //[995,9933]], // p,pbar
      "[2112,-2112]": [[995,995]], // n,nbar
      "[111,111]":    [[995,995]], // [995,9915]], // pi0,pi0
      "[311,-311]":   [[995,995]], // [995,9915]], // K0,K0bar
      "[113,113]":    [[995,995]], // [995,9915]], // rho0,rho0
      "[333,333]":    [[995,995]]                  // phi,phi
    },
    
    // Fixed-spin covariant LS model exchange pairs
    "XP": {
      "[211,-211]":   [[995,995], [995,9915], [9915,9915]], // [995,9933], // pi+,pi-
      "[321,-321]":   [[995,995], [995,9915], [9915,9915]], //[995,9933]], // K+,K-
      "[2212,-2212]": [[995,995], [995,9915], [9915,9915]], // [995,9915]], //[995,9933]], // p,pbar
      "[2112,-2112]": [[995,995]], // n,nbar
      "[111,111]":    [[995,995]], // [995,9915]], // pi0,pi0
      "[311,-311]":   [[995,995]], // [995,9915]], // K0,K0bar
      "[113,113]":    [[995,995]], // [995,9915]], // rho0,rho0
      "[333,333]":    [[995,995]]                  // phi,phi
    },
    
    // [GP/MP/XP] Four-body and six-body continuum Regge ladders (serial and parallel)
    "MULTI": {

      // Apply pomeron transfer form factors
      "FF_transfer_ext": true,    // external lines
      "FF_transfer_int": false,   // internal lines

      // Include secondary f2/a2 and rho/omega trajectories in the ladder
      "secondary_exchanges": false,

      // Coherently summed serial and parallel production topologies
      "partitions": {
        "4": [[4], [2,2]],
        "6": [[6], [4,2], [2,2,2]]
      },

      // auto: charged for charged states, all for states containing neutral particles
      // charged: charge-balanced combinations, all: complete combinations
      "permutations": "auto"
    }
  },

  // Exchanged-meson rows [abs(PDG), pole spin J, alpha' [GeV^-2]]
  // The trajectory is anchored by alpha(m^2)=J
  "meson_trajectories": [[111, 0.0, 0.70],
                          [211, 0.0, 0.70],
                          [311, 0.0, 0.70],
                          [321, 0.0, 0.70],
                          [113, 1.0, 0.90],
                          [333, 1.0, 0.90]],

  // Photoproduction rows
  // [abs(PDG), W0 [GeV], vector cross-section B_gammaPV [GeV^-2], alpha(0), alpha' [GeV^-2]]
  // The vector side amplitude level factor is F(t) = exp(B_gammaPV * t / 2)
  //
  // B_gammaPV is derived with the physical SOFT proton profile held fixed
  // The mapped SOFT Pomeron supplies the separate proton side vertex

  // See: develop/tools/HERA_couplings.py
  "photoprod_eta_mode": "rotating",

  "photoprod":
      [[   113, 40.0000,   4.8717,  1.0633,  0.1771],
       [   117, 40.0000,   4.0000,  1.0654,  0.2330],
       [   121, 40.0000,   4.0000,  1.0654,  0.2330],
       [   333, 70.0000,   3.7113,  1.0800,  0.2500],
       [   443, 100.0000,  1.0906,  1.197,   0.1354],
       [100443, 100.0000,  1.0906,  1.197,   0.1354],
       [   553, 100.0000,  1.0021,  1.1143,  0.0600],
       [100553, 100.0000,  1.0021,  1.1143,  0.0600],
       [200553, 100.0000,  1.0021,  1.1143,  0.0600]],

  // HERA target dissociation [PDG, W0, forward pd/el ratio at W0, delta, b, n, epsilon, M_max]
  // Generated using develop/tools/HERA_couplings.py
  // psi(2S) and Upsilon rows assume the J/psi proton transition with the elastic energy-power shift
  "photoprod_diss":
      [[   113, 40.0000,  0.2024, -0.1560,  4.8100,  8.5000,  0.0808, 10.0000],
       [   333, 94.0000,  0.3315,  0.3200,  3.2622,  9.5758,  0.0808, 29.7254],
       [   443, 90.0000,  0.2178,  0.3972,  1.8097,  3.5200,  0.0808, 10.0000],
       [100443, 90.0000,  0.2178,  0.3972,  1.8097,  3.5200,  0.0808, 10.0000],
       [   553, 90.0000,  0.2178,  0.0535,  1.8097,  3.5200,  0.0808, 10.0000],
       [100553, 90.0000,  0.2178,  0.0535,  1.8097,  3.5200,  0.0808, 10.0000],
       [200553, 90.0000,  0.2178,  0.0535,  1.8097,  3.5200,  0.0808, 10.0000]],

  // Fixed-scale double-log energy curvature [PDG, scale^2 [GeV^2], coefficient]
  // [REFERENCE: arXiv:1307.7099, Eq. (17)]
  "photoprod_dlog":
      [[443, 9.5908, 2.2004],
       [100443, 9.5908, 2.2004]],
  
  // Signed curvature terms preserving the common J/psi proton transition
  "photoprod_diss_dlog":
      [[553, 9.5908, -2.2004],
       [100553, 9.5908, -2.2004],
       [200553, 9.5908, -2.2004]]
},

// ---------------------------------------------------------------------
// [TP Tensor Pomeron model processes]

"PARAM_TENSORPOM" : {

  // High-energy forward helicity-conserving approximation
  // false evaluates the exact proton-Pomeron-proton spinor currents including flips
  "FORWARD_NOFLIP" : true,

  // Apply the TP decay phases in DECAYS.json
  "use_zeta" : true,

  // Tensor, vector and secondary exchange propagator parameters
  "EXCHANGES": {
    // [REFERENCE: arXiv: 1309.3478, Eqs. (3.10)-(3.13)]
    "995":  {"type": "P",  "delta":  0.0808, "ap": 0.25},
    // [REFERENCE: arXiv: 1309.3478, Eqs. (3.10)-(3.13)]
    "9915": {"type": "R2", "delta": -0.4525, "ap": 0.90},
    // [REFERENCE: arXiv: 1309.3478, Eqs. (3.10)-(3.13)]
    "9925": {"type": "R2", "delta": -0.4525, "ap": 0.90},
    // [REFERENCE: arXiv: 1911.01909, Sec. III, Odderon benchmark]
    "9993": {"type": "O",  "delta":  0.0500, "ap": 0.25, "eta": -1, "scale": 1.00},
    // [REFERENCE: arXiv: 1309.3478, Eqs. (3.14)-(3.15)]
    "9933": {"type": "R1", "delta": -0.4525, "ap": 0.90, "scale": 1.41},
    // [REFERENCE: arXiv: 1309.3478, Eqs. (3.14)-(3.15)]
    "9943": {"type": "R1", "delta": -0.4525, "ap": 0.90, "scale": 1.41}
  },

  // Tensor Pomeron continuum parameters
  "PARAM_CON": {

    // Selected Pomeron and f2 Reggeon terms, additional configured exchanges can be enabled
    "TP": {
        "[211,-211]":   [[995,995], [995,9915], [9915,9915]], // [995,9933], // pi+,pi-
        "[321,-321]":   [[995,995], [995,9915], [9915,9915]], //[995,9925], [995,9933], [995,9943]], // K+,K-
        "[2212,-2212]": [[995,995], [995,9915], [9915,9915]], // [995,9915]], //[995,9925], [995,9933], [995,9943]], // p,pbar
        "[2112,-2112]": [[995,995]], // n,nbar
        "[111,111]":    [[995,995]], // [995,9915]], // pi0,pi0
        "[311,-311]":   [[995,995]], // [995,9915]], //[995,9925]], // K0,K0bar
        "[113,113]":    [[995,995]], // [995,9915]], // rho0,rho0
        "[333,333]":    [[995,995]],                 // phi,phi
        "[*]":          [[995,995]]
    }
  },
  
  // Charged-meson continuum from arXiv:2508.06334
  "PHOTO": {
    "exchanges": [995,9915,9933],
    "photon_exchange": true,
    
    // [REFERENCE: arXiv: 2508.06334v2, Appendix A, Eq. (A.31)]
    "M0_2": 0.5000,

    // [REFERENCE: arXiv: 2508.06334v2, Sec. III and arXiv: 1804.04706, Table II]
    "Lambda": {"211": 1.7000, "321": 1.0000},
    
    // [REFERENCE: arXiv: 2609.01285, Eqs. (2.2), (2.15)-(2.18)]
    // FF_transfer supplies the full strong meson factor F in Eq. (2.2)
    // Figs. 2-6 use this factor once, interpreting the G ansatz in Eq. (2.19) as F
    // Use Lambda2/(Lambda2-t) for spacelike t as in arXiv:2508.06334v2, Eq. (A.31)
    "offshell": {
